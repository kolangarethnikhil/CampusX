# Client-side env vars. Safe to expose in browser.
VITE_GOOGLE_MAPS_API_KEY=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_VAPID_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_CAMPUS_ID=kju
VITE_ENABLE_SPACES_V2=true

# Server-only env vars. Do not prefix with VITE_.
GEMINI_API_KEY=
RESEND_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=
FIREBASE_PROJECT_ID=

# For local admin scripts only.
# Option A: set GOOGLE_APPLICATION_CREDENTIALS to a service account JSON file path.
GOOGLE_APPLICATION_CREDENTIALS=

# Option B: paste service account JSON as one line. Never expose this in frontend.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional: seed admin member into all default spaces.
SEED_ADMIN_UID=
CAMPUS_ID=kju
