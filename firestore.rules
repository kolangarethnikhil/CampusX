rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function validString(value, max) {
      return value is string && value.size() > 0 && value.size() <= max;
    }

    match /users/{userId} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if isOwner(userId)
        && incoming().uid == request.auth.uid
        && incoming().email is string
        && incoming().campusRole in ['Student', 'Alumni', 'Landlord', 'Seller']
        && incoming().verifiedStatus in ['unverified', 'pending'];

      allow update: if isOwner(userId)
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().campusRole in ['Student', 'Alumni', 'Landlord', 'Seller']
        && incoming().verifiedStatus in ['unverified', 'pending']
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'photoURL',
          'bio',
          'course',
          'batch',
          'collegeEmail',
          'campusRole',
          'verifiedStatus',
          'updatedAt'
        ]);

      allow delete: if false;
    }

    match /housing_listings/{listingId} {
      allow read: if true;

      allow create: if signedIn()
        && incoming().postedBy == request.auth.uid
        && validHousingListing(incoming());

      allow update: if isOwner(existing().postedBy)
        && incoming().postedBy == existing().postedBy
        && validHousingListing(incoming());

      allow delete: if isOwner(existing().postedBy);

      function validHousingListing(data) {
        return data.keys().hasAll([
          'title',
          'description',
          'roomType',
          'rent',
          'deposit',
          'postedBy',
          'status',
          'latitude',
          'longitude',
          'formattedAddress'
        ])
        && validString(data.title, 100)
        && validString(data.description, 2000)
        && data.roomType in ['single', 'shared', '1BHK', '2BHK', 'PG']
        && data.rent is number
        && data.rent > 0
        && data.deposit is number
        && data.deposit >= 0
        && data.latitude is number
        && data.longitude is number
        && validString(data.formattedAddress, 500)
        && data.postedBy == request.auth.uid
        && data.status in ['available', 'reserved', 'closed'];
      }
    }

    match /marketplace_listings/{listingId} {
      allow read: if true;

      allow create: if signedIn()
        && incoming().postedBy == request.auth.uid
        && validMarketplaceListing(incoming());

      allow update: if isOwner(existing().postedBy)
        && incoming().postedBy == existing().postedBy
        && validMarketplaceListing(incoming());

      allow delete: if isOwner(existing().postedBy);

      function validMarketplaceListing(data) {
        return data.keys().hasAll([
          'title',
          'description',
          'category',
          'price',
          'postedBy',
          'status',
          'latitude',
          'longitude',
          'formattedAddress'
        ])
        && validString(data.title, 100)
        && validString(data.description, 2000)
        && data.category in ['Furniture', 'Electronics', 'Books', 'Essentials', 'Other']
        && data.price is number
        && data.price > 0
        && data.latitude is number
        && data.longitude is number
        && validString(data.formattedAddress, 500)
        && data.postedBy == request.auth.uid
        && data.status in ['available', 'reserved', 'sold'];
      }
    }

    match /saved_listings/{savedId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;

      allow create: if signedIn()
        && incoming().userId == request.auth.uid
        && incoming().listingId is string
        && incoming().listingType in ['housing', 'market'];

      allow delete: if signedIn() && resource.data.userId == request.auth.uid;

      allow update: if false;
    }

    match /conversations/{conversationId} {
      allow read: if signedIn()
        && request.auth.uid in resource.data.participants;

      allow create: if signedIn()
        && incoming().participants is list
        && request.auth.uid in incoming().participants
        && incoming().participants.size() >= 2
        && incoming().participants.size() <= 10;

      allow update: if signedIn()
        && request.auth.uid in existing().participants
        && incoming().participants == existing().participants
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'lastMessage',
          'updatedAt'
        ]);

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;

        allow create: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          && incoming().senderId == request.auth.uid
          && validString(incoming().content, 1000);

        allow update, delete: if false;
      }
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && incoming().reporterId == request.auth.uid;

      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}