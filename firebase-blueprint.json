{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Information about a community member.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "collegeEmail": { "type": "string", "format": "email" },
        "campusRole": { "type": "string", "enum": ["Student", "Alumni", "Landlord", "Seller"] },
        "verifiedStatus": { "type": "string", "enum": ["unverified", "pending", "verified"] },
        "batch": { "type": "string" },
        "course": { "type": "string" },
        "bio": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "campusRole"]
    },
    "HousingListing": {
      "title": "Housing Listing",
      "description": "Room or flat available for rent.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "roomType": { "type": "string", "enum": ["single", "shared", "1BHK", "2BHK", "PG"] },
        "rent": { "type": "number" },
        "deposit": { "type": "number" },
        "furnishing": { "type": "string", "enum": ["Unfurnished", "Semi-furnished", "Fully-furnished"] },
        "preferTenants": { "type": "string", "enum": ["Bachelors", "Girls Only", "Boys Only", "Any"] },
        "location": { "type": "string" },
        "distance": { "type": "string" },
        "availableFrom": { "type": "string" },
        "genderPreference": { "type": "string", "enum": ["male", "female", "none"] },
        "amenities": { "type": "array" },
        "photos": { "type": "array" },
        "postedBy": { "type": "string" },
        "status": { "type": "string", "enum": ["available", "reserved", "closed"] },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "formattedAddress": { "type": "string" },
        "description": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "roomType", "rent", "postedBy", "status"]
    },
    "MarketplaceListing": {
      "title": "Marketplace Item",
      "description": "Furniture or essentials for sale.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "category": { "type": "string", "enum": ["Furniture", "Electronics", "Books", "Essentials", "Other"] },
        "price": { "type": "number" },
        "isNegotiable": { "type": "boolean" },
        "condition": { "type": "string", "enum": ["New", "Like New", "Good", "Fair"] },
        "reasonForSelling": { "type": "string" },
        "photos": { "type": "array" },
        "postedBy": { "type": "string" },
        "status": { "type": "string", "enum": ["available", "reserved", "sold"] },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "formattedAddress": { "type": "string" },
        "description": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "category", "price", "postedBy", "status"]
    },
    "SavedListing": {
      "title": "Saved Listing",
      "description": "A listing saved by a user.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "listingId": { "type": "string" },
        "listingType": { "type": "string", "enum": ["housing", "market"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "listingId", "listingType"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "A chat between two users regarding a listing.",
      "type": "object",
      "properties": {
        "participants": { "type": "array" },
        "listingId": { "type": "string" },
        "listingTitle": { "type": "string" },
        "listingType": { "type": "string" },
        "lastMessage": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["participants", "listingId"]
    },
    "Message": {
      "title": "Message",
      "description": "An individual message within a conversation.",
      "type": "object",
      "properties": {
        "senderId": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["senderId", "content"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "housing_listings/{listingId}": {
      "schema": "HousingListing",
      "description": "Housing marketplace"
    },
    "marketplace_listings/{listingId}": {
      "schema": "MarketplaceListing",
      "description": "Furniture and essentials marketplace"
    },
    "saved_listings/{savedId}": {
      "schema": "SavedListing",
      "description": "User bookmarks"
    },
    "conversations/{conversationId}": {
      "schema": "Conversation",
      "description": "Chat metadata"
    },
    "conversations/{conversationId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Chat messages"
    }
  }
}
